{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "postUpdateOptions": [
    "gomodTidy"
  ],
  "packageRules": [
    {
      "matchUpdateTypes": [
        "patch",
        "digest"
      ],
      "labels": [
        "renovate",
        "patch-update"
      ],
      "automerge": true
    },
    {
      "matchUpdateTypes": [
        "minor"
      ],
      "labels": [
        "renovate",
        "minor-update"
      ],
      "automerge": true
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "labels": [
        "renovate",
        "major-update"
      ],
      "dependencyDashboardApproval": true
    },
    {
      "matchManagers": [
        "gomod"
      ],
      "matchDepNames": [
        "go"
      ],
      "matchDepTypes": [
        "golang"
      ],
      "rangeStrategy": "bump"
    },
    {
      "matchManagers": [
        "gomod",
        "dockerfile"
      ],
      "matchPackageNames": [
        "go",
        "golang"
      ],
      "groupName": "Go version",
      "minimumGroupSize": 2
    }
  ],
  "dependencyDashboardLabels": [
    "renovate"
  ],
  "prConcurrentLimit": 4,
  "automergeType": "pr",
  "platformAutomerge": true,
  "commitMessagePrefix": "chore(deps):",
  "enabledManagers": [
    "gomod",
    "dockerfile",
    "github-actions"
  ]
}
